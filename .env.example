# Configuration Firebase utilisée par l'application.
# Projet : celui du back-office (crazee-burger3-admin), qui contient les produits.
#
# 1. Copier ce fichier et le renommer en ".env"
# 2. Remplir les valeurs depuis la console Firebase :
#    ⚙️ Paramètres du projet → Général → Vos applications → Configuration du SDK
#
# Ces valeurs ne sont pas secrètes : elles finissent dans le code envoyé au navigateur.
# La sécurité des données repose sur les règles Firestore (gérées dans le dépôt du back-office).
REACT_APP_API_KEY=
REACT_APP_AUTH_DOMAIN=
REACT_APP_PROJECT_ID=
REACT_APP_STORAGE_BUCKET=
REACT_APP_MESSAGING_SENDER_ID=
REACT_APP_APP_ID=
